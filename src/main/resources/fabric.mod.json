{
  "schemaVersion": 1,
  "id": "oldmc",
  "version": "${version}",
  "name": "OldMC",
  "description": "Restores the classic Minecraft experience.",
  "authors": [
    "smalldayDC_"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/oldmc",
    "issues": "https://github.com/ismudkipx/oldmc/issues",
    "sources": "https://github.com/ismudkipx/oldmc"
  },
  "environment": "client",
  "license": "MIT",
  "icon": "assets/oldmc/textures/gui/icon.png",
  "mixins": [
    {
      "config": "oldmc.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.17.3",
    "fabric-api": "*",
    "minecraft": "${minecraft}",
    "java": ">=${java}"
  },
  "entrypoints": {
    "oneconfig:config": [
      "me.mudkipx.oldmc.config.OldMCOneConfig"
    ],
    "modmenu": [
      "me.mudkipx.oldmc.config.OldMCModMenu"
    ],
    "sodium:config_api_user": [
      "me.mudkipx.oldmc.config.OldMCSodiumConfig"
    ]
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/oldmc"
      }
    }
  }
}
